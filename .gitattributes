# Normalize text files to LF in the repo, let Git convert to CRLF on checkout
# for Windows-only files. Binary files are marked explicitly.
* text=auto eol=lf

# SQL migrations must keep a stable byte representation: sqlx stores a checksum
# of each applied migration and refuses to start if the on-disk file no longer
# matches. Force LF here so CRLF conversion on Windows checkout can't drift the
# checksum away from what was recorded at first apply.
*.sql text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
